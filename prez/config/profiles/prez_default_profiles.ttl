PREFIX altr-ext: <http://www.w3.org/ns/dx/connegp/altr-ext#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX prez: <https://prez.dev/>
PREFIX prof: <http://www.w3.org/ns/dx/prof/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shext: <http://example.com/shacl-extension#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

altr-ext:alt-profile
    a
        prof:Profile ,
        prez:ListingProfile ,
        prez:ObjectProfile ;
    dcterms:description "The representation of the resource that lists all other representations (profiles and Media Types)" ;
    dcterms:identifier "alt"^^xsd:token ;
    dcterms:title "Alternates Profile" ;
    altr-ext:constrainsClass
        geo:Feature ,
        geo:FeatureCollection ,
        rdf:Property ,
        rdf:Resource ,
        rdfs:Class ,
        rdfs:Resource ,
        owl:AnnotationProperty ,
        owl:Class ,
        owl:DatatypeProperty ,
        owl:ObjectProperty ,
        owl:Ontology ,
        skos:Collection ,
        skos:Concept ,
        skos:ConceptScheme ,
        dcat:Catalog ,
        dcat:Dataset ,
        dcat:Resource ,
        prof:Profile ,
        sh:ShapesGraph ,
        <https://linked.data.gov.au/def/pid/PID> ,
        <https://linked.data.gov.au/def/pid/Pid> ,
        prez:AltProfilesList ,
        prez:Object ,
        schema:DataCatalog ,
        schema:Organization ,
        schema:Person ;
    altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
    altr-ext:hasResourceFormat
        "application/anot+ld+json" ,
        "application/ld+json" ,
        "application/rdf+xml" ,
        "text/anot+turtle" ,
        "text/turtle" ;
    sh:property
        [
            sh:path
                [
                    sh:union (
                        rdf:type
                        altr-ext:hasResourceFormat
                        altr-ext:hasDefaultResourceFormat
                        dcterms:description
                        dcterms:title
                        dcterms:identifier
                    ) ;
                ] ;
        ] ;
.

<https://prez.dev/profile/prez>
    a
        prof:Profile ,
        prez:IndexProfile ;
    dcterms:description "A profile for the Prez Linked Data API" ;
    dcterms:identifier "prez"^^xsd:token ;
    dcterms:title "Prez profile" ;
    altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
    altr-ext:hasResourceFormat
        "application/anot+ld+json" ,
        "application/ld+json" ,
        "application/rdf+xml" ,
        "text/anot+turtle" ,
        "text/turtle" ;
.

<https://prez.dev/profile/profiles>
    a
        prof:Profile ,
        prez:ListingProfile ,
        prez:ObjectProfile ;
    dcterms:description "A profile for displaying profiles." ;
    dcterms:identifier "prof"^^xsd:token ;
    dcterms:title "Profiles Profile" ;
    altr-ext:constrainsClass prof:Profile ;
    altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
    altr-ext:hasResourceFormat
        "application/anot+ld+json" ,
        "application/ld+json" ,
        "application/rdf+xml" ,
        "text/anot+turtle" ,
        "text/turtle" ;
    sh:property
        [
            sh:path
                [
                    sh:union (
                        
                        [
                            shext:bNodeDepth "25" ;
                        ]
                        rdf:type
                        altr-ext:hasResourceFormat
                        altr-ext:hasDefaultResourceFormat
                        dcterms:description
                        dcterms:title
                        dcterms:identifier
                    ) ;
                ] ;
        ] ;
.

<https://prez.dev/profile/open-object>
    a
        prof:Profile ,
        prez:ObjectProfile ;
    dcterms:description "PID Register metadata, excluding structural membership predicates." ;
    dcterms:identifier "openobj"^^xsd:token ;
    dcterms:title "Open profile" ;
    altr-ext:constrainsClass
        geo:Feature ,
        geo:FeatureCollection ,
        rdf:Property ,
        rdfs:Class ,
        rdfs:Resource ,
        owl:AnnotationProperty ,
        owl:Class ,
        owl:DatatypeProperty ,
        owl:ObjectProperty ,
        owl:Ontology ,
        skos:Collection ,
        skos:Concept ,
        skos:ConceptScheme ,
        dcat:Catalog ,
        dcat:Dataset ,
        dcat:Resource ,
        prof:Profile ,
        sh:ShapesGraph ,
        <https://linked.data.gov.au/def/pid/PID> ,
        <https://linked.data.gov.au/def/pid/Pid> ,
        prez:CQLFilterResult ,
        prez:Object ,
        prez:SPARQLQuery ,
        prez:SearchResult ,
        schema:DataCatalog ,
        schema:Organization ,
        schema:Person ;
    altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
    altr-ext:hasNodeShape
        [
            altr-ext:hasDefaultProfile <https://prez.dev/profile/open-object> ;
            sh:targetClass
                rdf:Property ,
                rdfs:Class ,
                rdfs:Resource ,
                owl:AnnotationProperty ,
                owl:Class ,
                owl:DatatypeProperty ,
                owl:ObjectProperty ,
                owl:Ontology ,
                sh:ShapesGraph ,
                <https://linked.data.gov.au/def/pid/PID> ,
                <https://linked.data.gov.au/def/pid/Pid> ,
                schema:DataCatalog ,
                schema:Organization ,
                schema:Person ;
        ] ;
    altr-ext:hasResourceFormat
        "application/anot+ld+json" ,
        "application/ld+json" ,
        "application/rdf+xml" ,
        "text/anot+turtle" ,
        "text/turtle" ;
    sh:property
        [
            sh:path
                [
                    sh:union (
                        
                        [
                            shext:bNodeDepth "25" ;
                        ]
                        <http://example.org/qualifiedStatus>
                        dcterms:isRequiredBy
                        rdf:first
                        rdf:rest
                        rdf:type
                        rdfs:domain
                        rdfs:isDefinedBy
                        rdfs:range
                        rdfs:subClassOf
                        xsd:pattern
                        owl:equivalentClass
                        owl:minQualifiedCardinality
                        owl:onClass
                        owl:onDatatype
                        owl:onProperty
                        owl:unionOf
                        owl:versionIRI
                        owl:withRestrictions
                        skos:example
                        skos:historyNote
                        time:hasBeginning
                        time:hasTime
                        time:inXSDDate
                        dcat:hadRole
                        dcat:qualifiedRelation
                        sh:class
                        sh:datatype
                        sh:deactivated
                        sh:maxCount
                        sh:message
                        sh:minCount
                        sh:nodeKind
                        sh:or
                        sh:path
                        sh:property
                        sh:select
                        sh:sparql
                        sh:targetClass
                        <https://linked.data.gov.au/def/lifecycle/hasLifecycleStage>
                        <https://linked.data.gov.au/def/pid/from>
                        <https://linked.data.gov.au/def/pid/headers>
                        <https://linked.data.gov.au/def/pid/redirectRules>
                        <https://linked.data.gov.au/def/pid/redirectTest>
                        <https://linked.data.gov.au/def/pid/to>
                        schema:additionalType
                        schema:agent
                        schema:alternateName
                        schema:backstory
                        schema:codeRepository
                        schema:copyrightHolder
                        schema:creator
                        schema:dateCreated
                        schema:dateIssued
                        schema:dateModified
                        schema:description
                        schema:identifier
                        schema:isPartOf
                        schema:license
                        schema:member
                        schema:memberOf
                        schema:name
                        schema:parentOrganization
                        schema:publisher
                        schema:sponsor
                        schema:status
                        schema:successorOf
                        schema:url
                        schema:value
                        schema:version
                    ) ;
                ] ;
        ] ;
.

<https://w3id.org/profile/mem>
    a
        prof:Profile ,
        prez:ListingProfile ;
    dcterms:description "Lists members of container resources." ;
    dcterms:identifier "mem"^^xsd:token ;
    dcterms:title "Members" ;
    altr-ext:constrainsClass
        rdf:Property ,
        rdfs:Class ,
        rdfs:Resource ,
        owl:AnnotationProperty ,
        owl:Class ,
        owl:DatatypeProperty ,
        owl:ObjectProperty ,
        owl:Ontology ,
        dcat:Catalog ,
        prof:Profile ,
        sh:NodeShape ,
        sh:PropertyShape ,
        sh:ShapesGraph ,
        <https://linked.data.gov.au/def/pid/PID> ,
        <https://linked.data.gov.au/def/pid/Pid> ,
        schema:DataCatalog ,
        schema:Organization ,
        schema:Person ;
    altr-ext:hasDefaultResourceFormat "text/anot+turtle" ;
    altr-ext:hasNodeShape
        [
            altr-ext:hasDefaultProfile <https://w3id.org/profile/mem> ;
            sh:targetClass
                rdf:Property ,
                rdfs:Class ,
                rdfs:Resource ,
                owl:AnnotationProperty ,
                owl:Class ,
                owl:DatatypeProperty ,
                owl:ObjectProperty ,
                owl:Ontology ,
                sh:ShapesGraph ,
                <https://linked.data.gov.au/def/pid/PID> ,
                <https://linked.data.gov.au/def/pid/Pid> ,
                schema:DataCatalog ,
                schema:Organization ,
                schema:Person ;
        ] ;
    altr-ext:hasResourceFormat
        "application/anot+ld+json" ,
        "application/ld+json" ,
        "application/rdf+xml" ,
        "text/anot+turtle" ,
        "text/turtle" ;
    sh:property
        [
            sh:path rdf:type ;
        ] ;
.
